# Infrastructure configuration.
# Public domain used by the deployment entrypoint.
DOMAIN=
# Base path used when the API is mounted behind a reverse proxy.
ROOT_PATH_BACKEND=/api
# Project name used to compose container names.
PROJECT_NAME=
# Deployment environment identifier used to compose container names.
DEPLOY_ENV=
# Container name prefix derived from project and environment values.
CONTAINER_INITIALS=${PROJECT_NAME}-${DEPLOY_ENV}
# Cloudflare tunnel token used by the cloudflared container.
CLOUDFLARED_TOKEN=

# Azure OpenAI configuration. Keep real values only in .env.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=
AZURE_OPENAI_AZURE_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
LLM_TEMPERATURE=0
LLM_REQUEST_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_MAX_CONTENT_CHARS=120000
